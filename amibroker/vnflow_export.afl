// ============================================================================
// vnflow_export.afl (ban 2 - cu phap toi gian) - Xuat lich su MetaKit ra CSV, moi ma mot file.
//   Moi dong = 1 phien: gia (ma goc) + cung cau dat lenh (_CC) + khoi ngoai (_NN).
// Cach chay: Analysis > Formula: file nay > Apply to: watchlist ma goc
//            > Range: From-To dates (01/01/2015 -> nay) > Settings: Periodicity Daily > EXPLORE.
// TAO THU MUC XUAT TRUOC (mac dinh C:\vnflow\metakit_export\).
// Quy uoc truong MetaKit 6 (da doi chieu ABW 06/2023):
//   ma goc: O H L C (nghin dong), V = KL, OI = so CP luu hanh
//   _CC: O = KL dat ban, C = KL dat mua, V = so lenh dat ban, OI = so lenh dat mua
//   _NN: O = KL ban, C = KL mua, V = GT ban (dong), OI = GT mua (dong)
// ============================================================================
SetBarsRequired(sbrAll, sbrAll);
outDir = ParamStr("Thu muc xuat", "C:\\vnflow\\metakit_export\\");

sym = Name();
isBase = StrFind(sym, "_") == 0;
act = Status("action");
nRows = 0;
fileOk = 0;

if (isBase AND (act == actionExplore OR act == actionScan))
{
    ccO = Foreign(sym + "_CC", "O", 0);
    ccC = Foreign(sym + "_CC", "C", 0);
    ccV = Foreign(sym + "_CC", "V", 0);
    ccI = Foreign(sym + "_CC", "I", 0);
    nnO = Foreign(sym + "_NN", "O", 0);
    nnC = Foreign(sym + "_NN", "C", 0);
    nnV = Foreign(sym + "_NN", "V", 0);
    nnI = Foreign(sym + "_NN", "I", 0);
    yr = Year();
    mo = Month();
    dy = Day();
    inRange = Status("barinrange");

    fh = fopen(outDir + sym + ".csv", "w");
    if (fh)
    {
        fileOk = 1;
        fputs("symbol,date,open,high,low,close,volume,shares_out,cc_dat_ban,cc_dat_mua,cc_lenh_ban,cc_lenh_mua,nn_kl_ban,nn_kl_mua,nn_gt_ban,nn_gt_mua\n", fh);
        for (i = 0; i < BarCount; i++)
        {
            if (inRange[i])
            {
                s = sym + "," + StrFormat("%04.0f-%02.0f-%02.0f", yr[i], mo[i], dy[i]);
                s = s + "," + NumToStr(O[i], 1.4, False) + "," + NumToStr(H[i], 1.4, False);
                s = s + "," + NumToStr(L[i], 1.4, False) + "," + NumToStr(C[i], 1.4, False);
                s = s + "," + NumToStr(V[i], 1.0, False) + "," + NumToStr(OI[i], 1.0, False);
                s = s + "," + WriteIf(IsNull(ccO[i]), "", NumToStr(ccO[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(ccC[i]), "", NumToStr(ccC[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(ccV[i]), "", NumToStr(ccV[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(ccI[i]), "", NumToStr(ccI[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(nnO[i]), "", NumToStr(nnO[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(nnC[i]), "", NumToStr(nnC[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(nnV[i]), "", NumToStr(nnV[i], 1.0, False));
                s = s + "," + WriteIf(IsNull(nnI[i]), "", NumToStr(nnI[i], 1.0, False));
                fputs(s + "\n", fh);
                nRows = nRows + 1;
            }
        }
        fclose(fh);
    }
}

Buy = 0;
Sell = 0;
Filter = Status("lastbarinrange") AND isBase;
AddColumn(nRows, "So dong da ghi", 1.0);
AddColumn(fileOk, "Ghi file OK (1=co)", 1.0);
AddTextColumn(outDir + sym + ".csv", "File");
